<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://github.com/AndrewFalse/sppr-supplier-selection/ontology"
         xmlns="https://github.com/AndrewFalse/sppr-supplier-selection/ontology#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="https://github.com/AndrewFalse/sppr-supplier-selection/ontology"/>

<owl:ObjectProperty rdf:about="#madeBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="#Vendor"/>
  <rdfs:label xml:lang="ru">производится вендором</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#producedIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="#Country"/>
  <rdfs:label xml:lang="ru">страна производства</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasChannel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vendor"/>
  <rdfs:range rdf:resource="#SupplyChannel"/>
  <rdfs:label xml:lang="ru">канал поставки</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#vendorCountry">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Vendor"/>
  <rdfs:range rdf:resource="#Country"/>
  <rdfs:label xml:lang="ru">страна вендора</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#replacement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="#Equipment"/>
  <rdfs:label xml:lang="ru">замена при срыве поставки</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#modelName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="ru">модель</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#priceRub">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">цена, руб.</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#leadWeeks">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">срок поставки, нед.</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#warrantyMonths">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">гарантия, мес.</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ahpPriority">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">приоритет АНР</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#qualityScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">оценка k2 (качество)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#reliabilityScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">оценка k3 (надёжность)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sanctionRiskScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
