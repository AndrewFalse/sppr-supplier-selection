</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#russianOriginScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">оценка k7 (российское происхождение)</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#unavailable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="ru">недоступна у продавцов</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#priceConfirmed">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="ru">цена подтверждена</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sellerWarrantyOnly">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="ru">гарантия только продавца</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#activePowerW">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
