</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#switchTimeMs">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">время переключения, мс</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ratedCurrentA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:label xml:lang="ru">номинальный ток, А</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rackMount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  <rdfs:label xml:lang="ru">стоечное исполнение</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#sfpPlusPorts">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label xml:lang="ru">портов SFP+</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#l3Routing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Equipment"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
